#!/bin/busybox sh
set -eu
export PATH=/bin:/sbin

/bin/busybox --install -s /bin

mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev

echo "===== Baseline kernel booted ====="
uname -r
echo "Type exit to shut down this guest."

setsid cttyhack /bin/sh || echo "Shell exited with an error."
poweroff -f
